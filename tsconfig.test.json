{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Globals de Vitest (describe/it/expect) + matchers jest-dom.
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "vitest.config.ts",
    "src/test/**/*.ts",
    "src/test/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "exclude": ["node_modules", "dist", "release", ".Leanna"]
}
